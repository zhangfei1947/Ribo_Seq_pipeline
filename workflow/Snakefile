"""Drosophila Ribo-seq/RNA-seq workflow: explicit QC review, then analysis."""

from collections import defaultdict
import csv
from pathlib import Path
import shlex


configfile: "config/config.yaml"


def read_tsv(path):
    with open(path, encoding="utf-8") as handle:
        return list(csv.DictReader(handle, delimiter="\t"))


SAMPLE_FILE = config["metadata"]["samples"]
CONTRAST_FILE = config["metadata"]["contrasts"]
DECISION_FILE = config["metadata"]["qc_decisions"]
CONFIG_FILE = config.get("pipeline_config", "config/config.yaml")
CONTAINER_LOCK = config.get("container_lock", "containers/lock.tsv")
SAMPLES = read_tsv(SAMPLE_FILE)
CONTRASTS = read_tsv(CONTRAST_FILE)
RUNS = {row["run_id"]: row for row in SAMPLES}
LIBRARY_RUNS = defaultdict(list)
for row in SAMPLES:
    LIBRARY_RUNS[row["library_id"]].append(row["run_id"])
LIBRARIES = {
    library: {**RUNS[runs[0]], "run_ids": runs}
    for library, runs in LIBRARY_RUNS.items()
}
STUDIES = sorted({row["study_id"] for row in SAMPLES})
RIBO_LIBRARIES = sorted(library for library, row in LIBRARIES.items() if row["assay"] == "ribo")
RNA_LIBRARIES = sorted(library for library, row in LIBRARIES.items() if row["assay"] == "rna")
PE_RUNS = sorted(run for run, row in RUNS.items() if row["layout"] == "PE")
PE_LIBRARIES = sorted(library for library, row in LIBRARIES.items() if row["layout"] == "PE")
POOL_MEMBERS = defaultdict(list)
LIBRARY_POOL = {}
for library in RIBO_LIBRARIES:
    row = LIBRARIES[library]
    pool_id = f"{row['study_id']}__{row.get('ribo_protocol_group', '')}"
    POOL_MEMBERS[pool_id].append(library)
    LIBRARY_POOL[library] = pool_id
RIBO_POOLS = sorted(POOL_MEMBERS)
WORK = config["directories"]["work"]
RESULTS = config["directories"]["results"]
ANALYSIS_ID = config["analysis_id"]
CORE = config["containers"]["core"]
R_IMAGE = config["containers"]["r"]


def result_dir(study):
    return f"{RESULTS}/{study}/{ANALYSIS_ID}"


def runs_for(wildcards):
    return LIBRARY_RUNS[wildcards.library]


def run_fastq2_arg(wildcards):
    value = RUNS[wildcards.run].get("fastq2", "")
    return f"--fastq2 {shlex.quote(value)}" if value else ""


def library_read1(wildcards):
    if LIBRARIES[wildcards.library]["assay"] == "ribo":
        return f"{WORK}/depleted/{wildcards.library}.fastq.gz"
    return f"{WORK}/libraries/{wildcards.library}.R1.fastq.gz"


def library_read2_arg(wildcards):
    row = LIBRARIES[wildcards.library]
    if row["layout"] == "PE":
        return f"--read2 {shlex.quote(f'{WORK}/libraries/{wildcards.library}.R2.fastq.gz')}"
    return ""


def star_index(wildcards):
    key = "ribo_star_index" if LIBRARIES[wildcards.library]["assay"] == "ribo" else "rna_star_index"
    return config["reference"][key]


def strand_code(library):
    return {"unstranded": 0, "forward": 1, "reverse": 2}[LIBRARIES[library]["strandedness"]]


def feature_gtf(wildcards):
    return (
        "resources/generated/gene_cds_union.gtf"
        if wildcards.region == "cds"
        else "resources/generated/gene_exon_union.gtf"
    )


def paired_featurecounts(wildcards):
    return "-p --countReadPairs -B -C" if LIBRARIES[wildcards.library]["layout"] == "PE" else ""


QC_TEMPLATE = f"{RESULTS}/qc/qc_decisions.template.tsv"
QC_FINGERPRINT = f"{RESULTS}/qc/qc_fingerprint.txt"
CONTRAST_SENTINELS = [
    f"{result_dir(row['study_id'])}/differential/{row['contrast_id']}/complete.txt"
    for row in CONTRASTS
]
FINAL_SENTINELS = [f"{result_dir(study)}/FINALIZED" for study in STUDIES]
FASTQC_TARGETS = []
if config.get("optional", {}).get("fastqc", True):
    FASTQC_TARGETS = (
        expand(f"{RESULTS}/qc/fastqc/raw/{{run}}.R1.html", run=sorted(RUNS))
        + expand(f"{RESULTS}/qc/fastqc/raw/{{run}}.R2.html", run=PE_RUNS)
        + expand(f"{RESULTS}/qc/fastqc/processed/{{library}}.R1.html", library=sorted(LIBRARIES))
        + expand(f"{RESULTS}/qc/fastqc/processed/{{library}}.R2.html", library=PE_LIBRARIES)
    )
MULTIQC_TARGETS = [f"{RESULTS}/qc/multiqc/multiqc_report.html"] if config.get("optional", {}).get("multiqc", True) else []


rule all:
    input:
        FINAL_SENTINELS


rule qc:
    input:
        QC_TEMPLATE,
        QC_FINGERPRINT,
        expand(f"{WORK}/alignment/{{library}}.analysis.bam.bai", library=sorted(LIBRARIES)),
        expand(f"{RESULTS}/qc/ribo/{{library}}/summary.json", library=RIBO_LIBRARIES),
        expand(f"{RESULTS}/qc/ribo/{{library}}/qc.html", library=RIBO_LIBRARIES),
        expand(f"{RESULTS}/qc/ribo_pooled/{{pool}}/offset_recommendations.tsv", pool=RIBO_POOLS),
        f"{RESULTS}/qc/replicate_correlations.tsv",
        FASTQC_TARGETS,
        MULTIQC_TARGETS,


rule analysis:
    input:
        FINAL_SENTINELS


rule validate_reference:
    input:
        gtf=config["reference"]["gtf"],
    output:
        "resources/generated/reference_validation.json"
    params:
        ribo_star=config["reference"]["ribo_star_index"],
        rna_star=config["reference"]["rna_star_index"],
        contaminant=config["reference"]["ribo_contaminant_index"],
        ribo_overhang=config["reference"]["expected_ribo_sjdb_overhang"],
        rna_overhang=config["reference"]["expected_rna_sjdb_overhang"],
        sa_index=config["reference"]["expected_genomeSAindexNbases"],
        release=config["reference"]["release"],
    shell:
        """
        python3 workflow/scripts/validate_reference.py --gtf {input.gtf:q} \
          --ribo-star {params.ribo_star:q} --rna-star {params.rna_star:q} \
          --contaminant-prefix {params.contaminant:q} --ribo-overhang {params.ribo_overhang} \
          --rna-overhang {params.rna_overhang} --sa-index-bases {params.sa_index} \
          --release {params.release:q} --output {output:q}
        """


rule validate_containers:
    input:
        lock=CONTAINER_LOCK,
    output:
        "resources/generated/container_validation.json"
    params:
        images=" ".join(
            f"--image {shlex.quote(role + '=' + config['containers'][role])}" for role in ("core", "r")
        )
    shell:
        """
        python3 workflow/scripts/validate_containers.py --lock {input.lock:q} {params.images} --output {output:q}
        """


rule validate_metadata:
    input:
        samples=SAMPLE_FILE,
        contrasts=CONTRAST_FILE,
    output:
        report=f"{WORK}/metadata/validation.qc.json",
        libraries=f"{WORK}/metadata/libraries.tsv",
    log:
        f"{config['directories']['logs']}/validate_metadata.log"
    shell:
        """
        python3 workflow/scripts/validate_metadata.py \
          --samples {input.samples:q} --contrasts {input.contrasts:q} --check-fastq \
          --report {output.report:q} --libraries {output.libraries:q} \
          > {log:q} 2>&1
        """


rule validate_reviewed_decisions:
    input:
        samples=SAMPLE_FILE,
        contrasts=CONTRAST_FILE,
        decisions=DECISION_FILE,
        fingerprint=QC_FINGERPRINT,
    output:
        report=f"{WORK}/metadata/validation.analysis.json",
        libraries=f"{WORK}/metadata/libraries.analysis.tsv",
    log:
        f"{config['directories']['logs']}/validate_reviewed_decisions.log"
    shell:
        """
        python3 workflow/scripts/validate_metadata.py \
          --samples {input.samples:q} --contrasts {input.contrasts:q} --check-fastq \
          --decisions {input.decisions:q} --expected-qc-fingerprint-file {input.fingerprint:q} \
          --report {output.report:q} --libraries {output.libraries:q} \
          > {log:q} 2>&1
        """


rule build_annotation:
    input:
        gtf=config["reference"]["gtf"],
        validation=rules.validate_reference.output,
    output:
        all_genes="resources/generated/gene_annotation.tsv",
        cds_genes="resources/generated/cds_gene_annotation.tsv",
        reps="resources/generated/representative_transcripts.tsv",
        cds_gtf="resources/generated/gene_cds_union.gtf",
        exon_gtf="resources/generated/gene_exon_union.gtf",
        rep_cds="resources/generated/representative_cds.tsv",
    log:
        f"{config['directories']['logs']}/build_annotation.log"
    shell:
        """
        python3 workflow/scripts/build_gene_annotation.py \
          --gtf {input.gtf:q} --annotation-release {config[reference][release]:q} \
          --all-genes {output.all_genes:q} --cds-genes {output.cds_genes:q} \
          --representative-transcripts {output.reps:q} \
          --gene-cds-gtf {output.cds_gtf:q} --gene-exon-gtf {output.exon_gtf:q} \
          --representative-cds {output.rep_cds:q} > {log:q} 2>&1
        """


rule preprocess_run:
    input:
        metadata=rules.validate_metadata.output.report,
        container_validation=rules.validate_containers.output,
        read1=lambda wc: RUNS[wc.run]["fastq1"],
    output:
        read1=f"{WORK}/preprocessed/{{run}}.R1.fastq.gz",
        read2=f"{WORK}/preprocessed/{{run}}.R2.fastq.gz",
        report=f"{WORK}/preprocessed/{{run}}.json",
    params:
        read2=run_fastq2_arg,
        layout=lambda wc: RUNS[wc.run]["layout"],
        adapter=lambda wc: RUNS[wc.run].get("adapter_3p", "none"),
        umi=lambda wc: RUNS[wc.run].get("umi_pattern", "none"),
        minimum=lambda wc: config["preprocessing"]["ribo_min_length"] if RUNS[wc.run]["assay"] == "ribo" else config["preprocessing"]["rna_min_length"],
        maximum=lambda wc: f"--maximum-length {config['preprocessing']['ribo_max_length']}" if RUNS[wc.run]["assay"] == "ribo" else "",
        quality=config["preprocessing"]["quality_trim_3p"],
    threads: 4
    resources:
        runtime=120,
        mem_mb=8192,
    container:
        CORE
    log:
        f"{config['directories']['logs']}/preprocess/{{run}}.log"
    shell:
        """
        python3 workflow/scripts/preprocess_reads.py \
          --fastq1 {input.read1:q} {params.read2} --layout {params.layout:q} \
          --adapter {params.adapter:q} --umi-pattern {params.umi:q} \
          --minimum-length {params.minimum} {params.maximum} --quality-3p {params.quality} \
          --threads {threads} --output1 {output.read1:q} --output2 {output.read2:q} \
          --report {output.report:q} > {log:q} 2>&1
        """


rule fastqc_raw1:
    input:
        lambda wc: RUNS[wc.run]["fastq1"]
    output:
        html=f"{RESULTS}/qc/fastqc/raw/{{run}}.R1.html",
        archive=f"{RESULTS}/qc/fastqc/raw/{{run}}.R1.zip",
    threads: 2
    resources:
        runtime=60,
        mem_mb=4096,
    container:
        CORE
    shell:
        "python3 workflow/scripts/run_fastqc.py --input {input:q} --html {output.html:q} --zip {output.archive:q} --threads {threads}"


rule fastqc_raw2:
    input:
        lambda wc: RUNS[wc.run]["fastq2"]
    output:
        html=f"{RESULTS}/qc/fastqc/raw/{{run}}.R2.html",
        archive=f"{RESULTS}/qc/fastqc/raw/{{run}}.R2.zip",
    threads: 2
    resources:
        runtime=60,
        mem_mb=4096,
    container:
        CORE
    wildcard_constraints:
        run="|".join(PE_RUNS)
    shell:
        "python3 workflow/scripts/run_fastqc.py --input {input:q} --html {output.html:q} --zip {output.archive:q} --threads {threads}"


rule merge_library_read1:
    input:
        lambda wc: [f"{WORK}/preprocessed/{run}.R1.fastq.gz" for run in LIBRARY_RUNS[wc.library]]
    output:
        f"{WORK}/libraries/{{library}}.R1.fastq.gz"
    container:
        CORE
    shell:
        "python3 workflow/scripts/merge_fastq.py --inputs {input:q} --output {output:q}"


rule merge_library_read2:
    input:
        lambda wc: [f"{WORK}/preprocessed/{run}.R2.fastq.gz" for run in LIBRARY_RUNS[wc.library]]
    output:
        f"{WORK}/libraries/{{library}}.R2.fastq.gz"
    container:
        CORE
    shell:
        "python3 workflow/scripts/merge_fastq.py --inputs {input:q} --output {output:q}"


rule filter_ribo_contaminants:
    input:
        f"{WORK}/libraries/{{library}}.R1.fastq.gz"
    output:
        read=f"{WORK}/depleted/{{library}}.fastq.gz",
        metrics=f"{WORK}/depleted/{{library}}.json",
    params:
        index=config["reference"]["ribo_contaminant_index"],
    threads: 8
    resources:
        runtime=120,
        mem_mb=8192,
    container:
        CORE
    log:
        f"{config['directories']['logs']}/contaminants/{{library}}.log"
    wildcard_constraints:
        library="|".join(RIBO_LIBRARIES)
    shell:
        """
        python3 workflow/scripts/filter_contaminants.py --input {input:q} --output {output.read:q} \
          --index {params.index:q} --threads {threads} --metrics {output.metrics:q} \
          > {log:q} 2>&1
        """


