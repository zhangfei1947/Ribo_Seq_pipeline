#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${project_root}"
mkdir -p containers/images

apptainer build --fakeroot containers/images/riboseq-core.sif containers/core.def
apptainer build --fakeroot containers/images/riboseq-r.sif containers/r.def
sha256sum containers/images/riboseq-core.sif containers/images/riboseq-r.sif

